persistence:
  enabled: true
  size: 10Gi

strategy:
  type: Recreate

postgresql-ha:
  enabled: false

valkey:
  enabled: false

valkey-cluster:
  enabled: false

postgresql:
  enabled: true
  global:
    postgresql:
      auth:
        username: gitea
        database: gitea
        password: "{{ gitea_postgres_password }}"

gitea:
  admin:
    existingSecret: gitea-admin-secret
    email: "{{ gitea_admin_email }}"
    passwordMode: keepUpdated

  oauth:
    - name: "Okta"
      provider: "openidConnect"
      key: "{{ okta_gitea_client_id }}"
      secret: "{{ okta_gitea_client_secret }}"
      autoDiscoverUrl: "{{ okta_gitea_issuer }}/.well-known/openid-configuration"
      groupClaimName: "groups"
      adminGroup: "homelab-admins"
      restrictedGroup: "homelab-viewers"

  metrics:
    enabled: true
    serviceMonitor:
      enabled: true

  config:
    server:
      DOMAIN: git.home.lab
      ROOT_URL: https://git.home.lab/

ingress:
  enabled: true
  className: traefik
  annotations:
    cert-manager.io/cluster-issuer: homelab-ca
  hosts:
    - host: git.home.lab
      paths:
        - path: /
  tls:
    - secretName: gitea-tls-cert
      hosts:
        - git.home.lab
