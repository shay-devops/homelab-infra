services:
  vaultwarden:
    image: vaultwarden/server:latest
    container_name: vaultwarden
    restart: unless-stopped
    environment:
      ADMIN_TOKEN: "{{ vaultwarden_admin_token }}"
      WEBSOCKET_ENABLED: "true"
      DOMAIN: "https://{{ vaultwarden_hostname }}"
      SIGNUPS_ALLOWED: "false"
    volumes:
      - /opt/it-docs/vaultwarden:/data

  mariadb:
    image: mariadb:11
    container_name: mariadb
    restart: unless-stopped
    environment:
      MYSQL_ROOT_PASSWORD: "{{ mariadb_root_password }}"
      MYSQL_DATABASE: bookstack
      MYSQL_USER: bookstack
      MYSQL_PASSWORD: "{{ mariadb_app_password }}"
    volumes:
      - /opt/it-docs/mariadb:/var/lib/mysql
    healthcheck:
      test: ["CMD-SHELL", "mariadb-admin ping -h localhost -u root -p\"$$MYSQL_ROOT_PASSWORD\" --silent"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 60s

  bookstack:
    image: lscr.io/linuxserver/bookstack:latest
    container_name: bookstack
    restart: unless-stopped
    depends_on:
      mariadb:
        condition: service_healthy
    environment:
      PUID: "1000"
      PGID: "1000"
      APP_KEY: "{{ bookstack_app_key }}"
      APP_URL: "https://{{ bookstack_hostname }}"
      DB_HOST: mariadb
      DB_PORT: "3306"
      DB_USERNAME: bookstack
      DB_PASSWORD: "{{ mariadb_app_password }}"
      DB_DATABASE: bookstack
    volumes:
      - /opt/it-docs/bookstack:/config

  caddy:
    image: caddy:latest
    container_name: caddy
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - /opt/it-docs/caddy/Caddyfile:/etc/caddy/Caddyfile
      - /opt/it-docs/caddy/data:/data
      - /opt/it-docs/caddy/config:/config
    depends_on:
      - vaultwarden
      - bookstack
