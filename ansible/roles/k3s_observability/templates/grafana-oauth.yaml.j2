# Adds Okta OIDC SSO to Grafana via [auth.generic_oauth], alongside local
# username/password auth (kept as break-glass access, not removed). Client
# ID/secret and issuer come from Vault (homelab/okta/grafana) via this role -
# never committed in plaintext.
#
# role_attribute_path maps the Okta 'groups' claim (configured on Okta's
# default Authorization Server, filtered to homelab-*) to Grafana's built-in
# roles: homelab-admins -> Admin, homelab-viewers -> Viewer, anyone else ->
# Viewer as a safe default rather than no access.
apiVersion: v1
kind: Secret
metadata:
  labels:
    app.kubernetes.io/component: grafana
    app.kubernetes.io/name: grafana
    app.kubernetes.io/part-of: kube-prometheus
    app.kubernetes.io/version: 13.0.2
  name: grafana-config
  namespace: monitoring
stringData:
  grafana.ini: |
    [server]
    root_url = https://grafana.home.lab

    [date_formats]
    default_timezone = UTC

    [auth.generic_oauth]
    enabled = true
    name = Okta
    client_id = {{ okta_grafana_client_id }}
    client_secret = {{ okta_grafana_client_secret }}
    scopes = openid profile email
    auth_url = {{ okta_grafana_issuer }}/v1/authorize
    token_url = {{ okta_grafana_issuer }}/v1/token
    api_url = {{ okta_grafana_issuer }}/v1/userinfo
    role_attribute_path = contains(groups[*], 'homelab-admins') && 'Admin' || contains(groups[*], 'homelab-viewers') && 'Viewer' || 'Viewer'
    allow_sign_up = true
type: Opaque
